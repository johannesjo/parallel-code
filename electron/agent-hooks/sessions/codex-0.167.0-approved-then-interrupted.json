{
  "command": "codex",
  "hooks": "codex",
  "version": "0.167.0",
  "summary": "The user approves a command, then presses Esc while the model is replying.",
  "recorded": "Hook payloads from Codex CLI driven through its terminal UI against a scripted model. Ids and paths are replaced; everything else is as Codex wrote it to the hook.",
  "steps": [
    {
      "hook": {
        "session_id": "session-1",
        "transcript_path": "/codex-home/sessions/rollout-1.jsonl",
        "cwd": "/work",
        "hook_event_name": "SessionStart",
        "model": "gpt-6.1-sol",
        "permission_mode": "default",
        "source": "startup"
      }
    },
    {
      "hook": {
        "session_id": "session-1",
        "turn_id": "turn-1",
        "transcript_path": "/codex-home/sessions/rollout-1.jsonl",
        "cwd": "/work",
        "hook_event_name": "UserPromptSubmit",
        "model": "gpt-6.1-sol",
        "permission_mode": "default",
        "prompt": "touch the file"
      }
    },
    {
      "expect": "active"
    },
    {
      "hook": {
        "session_id": "session-1",
        "turn_id": "turn-1",
        "transcript_path": "/codex-home/sessions/rollout-1.jsonl",
        "cwd": "/work",
        "hook_event_name": "PreToolUse",
        "model": "gpt-6.1-sol",
        "permission_mode": "default",
        "tool_name": "Bash",
        "tool_input": {
          "command": "touch pc-hook-probe.txt"
        },
        "tool_use_id": "exec-1"
      }
    },
    {
      "expect": "active"
    },
    {
      "hook": {
        "session_id": "session-1",
        "turn_id": "turn-1",
        "transcript_path": "/codex-home/sessions/rollout-1.jsonl",
        "cwd": "/work",
        "hook_event_name": "PermissionRequest",
        "model": "gpt-6.1-sol",
        "permission_mode": "default",
        "tool_name": "Bash",
        "tool_input": {
          "command": "touch pc-hook-probe.txt",
          "description": "create the probe file"
        }
      }
    },
    {
      "expect": "needs_input"
    },
    {
      "hook": {
        "session_id": "session-1",
        "turn_id": "turn-1",
        "transcript_path": "/codex-home/sessions/rollout-1.jsonl",
        "cwd": "/work",
        "hook_event_name": "PostToolUse",
        "model": "gpt-6.1-sol",
        "permission_mode": "default",
        "tool_name": "Bash",
        "tool_input": {
          "command": "touch pc-hook-probe.txt"
        },
        "tool_response": "",
        "tool_use_id": "exec-1"
      }
    },
    {
      "expect": "active"
    },
    {
      "hook": {
        "session_id": "session-1",
        "turn_id": "turn-1",
        "transcript_path": "/codex-home/sessions/rollout-1.jsonl",
        "cwd": "/work",
        "hook_event_name": "Interrupt",
        "model": "gpt-6.1-sol",
        "permission_mode": "default"
      }
    },
    {
      "expect": "idle"
    }
  ]
}
