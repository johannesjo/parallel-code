<?xml version="1.0" encoding="utf-8"?>
<!-- Credentials for the linked computer must not move to another device or cloud backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
